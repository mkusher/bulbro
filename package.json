{
	"name": "bulbro-game",
	"workspaces": [
		"web/",
		"server/",
		"packages/*"
	],
	"scripts": {
		"types": "tsc --project packages/network-protocol && tsc --project web && tsc --project server",
		"format": "biome format --fix packages/network-protocol/src web/src server/src",
		"check": "biome check packages/network-protocol/src web/src server/src",
		"build": "(cd web && bun run --bun build)",
		"start:server": "(cd server && bun start)"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/bun": "1.4.2",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@preact/signals": "^2.11.2"
	}
}
