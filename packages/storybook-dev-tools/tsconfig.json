{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"paths": {
			"@/*": ["../../web/src/*"],
			"bulbro-game-web/src/*": ["../../web/src/*"]
		},
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "../.."
	},
	"include": [
		"src",
		"../../web/src/css-modules.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
